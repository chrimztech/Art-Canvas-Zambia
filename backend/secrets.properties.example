# Copy this file to "secrets.properties" (same folder) and fill in your keys.
# secrets.properties is git-ignored, so the keys never reach GitHub or Lovable.
# Restart the backend after editing. Blank values fall back to the defaults in application.yml.

# --- Lenco (dashboard: https://dashboard.lenco.co -> Settings -> API keys) ---
LENCO_API_TOKEN=
LENCO_PUBLIC_KEY=
LENCO_ACCOUNT_ID=
# Sandbox is the default. For live payments uncomment both lines:
#LENCO_API_BASE_URL=https://api.lenco.co/access/v2
#LENCO_WIDGET_URL=https://pay.lenco.co/js/v1/inline.js

# --- ZynlePay (replace the demo values with your merchant credentials) ---
#ZYNLEPAY_MERCHANT_ID=
#ZYNLEPAY_API_ID=
#ZYNLEPAY_API_KEY=
#ZYNLEPAY_WEBHOOK_TOKEN=

# --- Email (order, offer and password-reset emails) ---
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
